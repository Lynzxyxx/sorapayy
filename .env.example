# =========================================================
# FIREBASE CLIENT CONFIG (aman untuk diekspos ke browser,
# TAPI tetap set sebagai Environment Variables di Vercel)
# Ambil dari: Firebase Console > Project Settings > General > Your apps
# =========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =========================================================
# FIREBASE ADMIN SDK (RAHASIA — JANGAN PERNAH commit ke git
# atau ekspos ke client). Ambil dari:
# Firebase Console > Project Settings > Service Accounts >
# Generate New Private Key (akan download file JSON)
# Isi 3 variabel di bawah dari isi file JSON tsb.
# Untuk FIREBASE_PRIVATE_KEY, ganti semua newline literal
# dengan "\n" (satu baris string), lihat contoh di README.
# =========================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Daftar email yang dianggap admin (dipisah koma).
# Dipakai HANYA sebagai fallback awal / oleh scripts/grantAdmin.js
ADMIN_EMAILS=gilang8301@gmail.com

# Nama & URL site untuk SEO
NEXT_PUBLIC_SITE_NAME=SoraPay
NEXT_PUBLIC_SITE_URL=https://sorapay.vercel.app

# =========================================================
# DEPOSIT OTOMATIS — buatqris.site (RAHASIA, server-only)
# Isi sesuai akun & dokumentasi resmi buatqris.site Anda.
# Lihat komentar TODO di lib/qris.js sebelum go-live —
# endpoint & nama field di file itu masih perlu disesuaikan
# karena dokumentasi publiknya tidak saya temukan saat build ini.
# =========================================================
QRIS_API_BASE_URL=https://buatqris.site/api
QRIS_API_KEY=
QRIS_MERCHANT_ID=
QRIS_WEBHOOK_SECRET=
